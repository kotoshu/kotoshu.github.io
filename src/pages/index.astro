---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Logo from '~/components/Logo.astro'
import SectionHeading from '~/components/SectionHeading.astro'
import VerticalAccent from '~/components/VerticalAccent.astro'
import DemoPanel from '~/components/home/DemoPanel.vue'
import InstallTabs from '~/components/home/InstallTabs.vue'
import { AUDIENCES } from '~/data/audiences'
import { PROJECTS } from '~/data/projects'
import { FULL_LANGUAGES, FREQUENCY_LANGUAGES, LANGUAGE_STATS, KELLY_LANGUAGES } from '~/data/languages'
import { SITE } from '~/data/site'
import { GRAMMAR_MODELS } from '~/data/grammar-models'

const byRepo = Object.fromEntries(GRAMMAR_MODELS.map((m) => [m.repo, m]))
const FEATURED_GRAMMAR = [
  {
    repo: 'grammar-en',
    label: 'English · CoNLL-14',
    meta: 'official M² scorer — 3.4× LanguageTool',
    accent: true,
  },
  { repo: 'grammar-fr', label: 'French · held-out', meta: 'strict span scorer, fp16 weights' },
  { repo: 'grammar-ko', label: 'Korean · held-out', meta: 'recall 2.3× its earlier weights' },
  { repo: 'grammar-it', label: 'Italian · held-out', meta: 'the largest gain: +115% on the same benchmark' },
].map((f) => {
  const m = byRepo[f.repo]
  return { ...f, score: m && m.benchmark.score ? m.benchmark.score : '—' }
})
const GRAMMAR_COUNT = GRAMMAR_MODELS.length

const featured = PROJECTS.filter((p) => p.featured)
---

<BaseLayout title={SITE.name}>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="zen-glow" aria-hidden="true"></div>
    <div class="kanji-watermark" aria-hidden="true" lang="ja">言修</div>

    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-20 pb-20 sm:pt-28 sm:pb-28 text-center">
      <VerticalAccent text="言葉を修める" />
      <Logo size={64} class="mx-auto mb-8 animate-in" />
      <p class="entry mb-7 animate-in">
        <span class="headword">ko·to·shu</span>
        <span class="jp" lang="ja">言修</span>
        <span class="pos">n.</span>
      </p>
      <h1 class="display mx-auto max-w-3xl text-[2.6rem] leading-[1.06] sm:text-7xl text-balance text-[var(--color-text)] animate-in">
        The fixing and <span id="hero-mend" class="mend">embellishing</span> of&nbsp;words.
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base sm:text-lg leading-8 text-pretty text-[var(--color-text-2)] animate-in">
        Kotoshu checks spelling and grammar in the terminal, the editor, and
        CI. The engine is pure Ruby, and the checker detects the language of
        the text before it resolves the dictionary and the language model
        that the text needs; it downloads nothing without an explicit setup
        action.
      </p>

      <div class="mx-auto mt-10 max-w-xl animate-in">
        <InstallTabs
          client:visible
          tabs={[
            { id: 'npm', label: 'npm', hint: 'Client + wasm engine', command: 'npm install @kotoshu/client @kotoshu/wasm' },
            { id: 'python', label: 'Python', hint: 'Client + native engine', command: 'pip install kotoshu kotoshu-native' },
            { id: 'gem', label: 'Ruby', hint: 'Reference library & CLI', command: 'gem install kotoshu' },
            { id: 'cargo', label: 'Rust', hint: 'The engine crate', command: 'cargo add kotoshu' },
            { id: 'action', label: 'GitHub Action', hint: 'SARIF in the Security tab', command: 'uses: kotoshu/action-kotoshu@v2' },
            { id: 'server', label: 'HTTP API', hint: 'Self-host — SDKs for Python, JS, Go', command: 'gem install kotoshu-server' },
          ]}
        />
      </div>

      <div class="mt-8 flex items-center justify-center gap-6 text-sm animate-in">
        <a
          href="/install"
          class="rounded-full bg-[var(--color-accent)] px-5 py-2 text-[var(--color-bg)] font-medium transition-colors hover:bg-[var(--color-accent-hover)]"
        >
          Get started
        </a>
        <a href="/playground" class="text-[var(--color-text-2)] hover:text-[var(--color-accent)] transition-colors">
          Try it in the browser →
        </a>
        <a href="/projects" class="text-[var(--color-text-2)] hover:text-[var(--color-accent)] transition-colors">
          Explore the ecosystem →
        </a>
      </div>
    </div>
  </section>

  <!-- Demo -->
  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-24">
      <SectionHeading
        jp="実演"
        eyebrow="See it work"
        title="The checker surfaces misspellings and offers a fix in place"
        lead="The demo runs the same engine that the editor extension and the CLI run against a full installation."
      />
      <div class="mx-auto mt-12 max-w-3xl">
        <DemoPanel client:visible />
        <p class="mt-4 text-center text-xs text-[var(--color-text-3)]">
          The <a href="/playground" class="text-[var(--color-accent)] hover:underline">playground</a> runs this engine in the browser, and it can connect to <a href="/playground/server" class="text-[var(--color-accent)] hover:underline">a self-hosted server</a> instead.
        </p>
      </div>
    </div>
  </section>

  <!-- Grammar models -->
  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-24">
      <SectionHeading
        jp="訂正"
        eyebrow="Grammar models"
        title={'Grammar correction for ' + GRAMMAR_COUNT + ' languages, measured on held-out benchmarks'}
        lead="Each language ships one fp16 ONNX artifact, decoded from the shipped file and scored on the fixed held-out benchmark that its earlier weights measured on. The scorecard records both numbers, so every comparison names its data."
      />
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {FEATURED_GRAMMAR.map((g) => (
          <div class:list={[
            'rounded-xl border bg-[var(--color-bg)] p-6',
            g.accent ? 'border-[var(--color-accent)]' : 'border-[var(--color-border)]',
          ]}>
            <p class="scorecard-num">{g.score}</p>
            <p class="mt-2 text-sm font-medium text-[var(--color-text)]">{g.label}</p>
            <p class="mt-1 text-xs leading-5 text-[var(--color-text-3)]">{g.meta}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-center text-sm">
        <a href="/grammars" class="text-[var(--color-accent)] hover:underline">
          The full scorecard — protocols, artifacts, and platform verification →
        </a>
      </p>
    </div>
  </section>


  <!-- Audiences -->
  <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-inset)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-24">
      <SectionHeading
        jp="使う人"
        eyebrow="Who it serves"
        title="One engine serves five audiences"
        lead="Five audiences start from five entry points, which range from a Ruby API to a one-line GitHub Action."
      />
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {AUDIENCES.map((a, i) => (
          <a
            href={`/audiences#${a.id}`}
            class:list={[
              'group rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)] p-6 transition-all duration-300 hover:border-[var(--color-accent)] hover:shadow-lg hover:shadow-black/[0.03] animate-in',
              i >= 3 && 'sm:col-span-2 lg:col-span-1',
            ]}
            style={`transition-delay:${i * 60}ms`}
          >
            <span class="kanji text-2xl text-[var(--color-accent)]" lang="ja">{a.kanji}</span>
            <h3 class="mt-3 text-base font-semibold text-[var(--color-text)]">{a.name}</h3>
            <p class="mt-2 text-sm leading-6 text-[var(--color-text-2)]">{a.headline}</p>
            <p class="mt-3 font-mono text-[11px] text-[var(--color-gold)]">{a.install}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Ecosystem -->
  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-24">
      <SectionHeading
        jp="生態系"
        eyebrow="The ecosystem"
        title="The gem sits at the center of the ecosystem"
        lead="Every other surface is a thin adapter over the same engine, so the checking logic exists in one place."
      />
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {featured.map((p, i) => (
          <a
            href={`/projects#${p.id}`}
            class="group rounded-xl border border-[var(--color-border)] p-6 transition-all duration-300 hover:border-[var(--color-accent)] hover:shadow-lg hover:shadow-black/[0.03] animate-in"
            style={`transition-delay:${i * 60}ms`}
          >
            <div class="flex items-center justify-between">
              <h3 class="font-mono text-sm font-semibold text-[var(--color-text)]">{p.name}</h3>
              <span class="rounded-full bg-[var(--color-accent-soft)] px-2 py-0.5 text-[10px] font-medium uppercase tracking-wider text-[var(--color-accent)]">
                {p.status}
              </span>
            </div>
            <p class="mt-2 text-sm font-medium text-[var(--color-text-2)]">{p.tagline}</p>
            <p class="mt-3 text-[13px] leading-6 text-[var(--color-text-3)] line-clamp-3">{p.description}</p>
          </a>
        ))}
      </div>
      <p class="mt-8 text-center text-sm">
        <a href="/projects" class="text-[var(--color-accent)] hover:underline">
          All {PROJECTS.length} projects — SDKs, content repos, and infrastructure →
        </a>
      </p>
    </div>
  </section>

  <!-- Languages -->
  <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-inset)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-24">
      <SectionHeading
        jp="言葉"
        eyebrow="Language support"
        title={`${LANGUAGE_STATS.fullFeature} languages are fully featured, and ${LANGUAGE_STATS.dictionariesStaged} more have dictionaries staged`}
        lead="A fully featured language carries spelling with affixes, semantic reranking, and keyboard-aware suggestions; frequency ranking accompanies the languages for which Kelly data exists."
      />

      <div class="mx-auto mt-12 max-w-4xl animate-in">
        <p class="dict-banner"><span lang="ja">辞書</span> dictionary of supported languages</p>
        <div class="md:grid md:grid-cols-2 md:gap-x-14">
          {FULL_LANGUAGES.map((l) => (
            <a href={`/languages/${l.code}`} class="dict-entry group transition-colors hover:bg-[var(--color-bg)]">
              <span class="dict-headword">{l.code}</span>
              <span>
                <span class="dict-sense">
                  <strong class="font-semibold">{l.native}</strong>
                  <span class="pos"> n.</span> — full feature
                </span>
                <span class="dict-anno block">
                  {['affixes', KELLY_LANGUAGES.includes(l.code) ? 'frequency' : null, 'semantic', l.keyboards]
                    .filter(Boolean)
                    .join(' · ')}
                </span>
              </span>
            </a>
          ))}
        </div>
        <p class="dict-also">
          <span class="pos">see also</span>
          {/* no is nb's registry alias — nb is full feature above, so only ar and zh remain frequency-only */}
          {FREQUENCY_LANGUAGES.filter((l) => !FULL_LANGUAGES.some((f) => f.code === l.code) && l.code !== 'no').map((l) => l.code).join(', ')} — frequency tiers only
        </p>
      </div>

      <div class="mx-auto mt-12 grid max-w-3xl grid-cols-3 gap-px overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-border)] text-center">
        <div class="bg-[var(--color-bg)] px-4 py-6">
          <p class="display text-3xl text-[var(--color-accent)]">{LANGUAGE_STATS.fullFeature}</p>
          <p class="mt-1 text-xs uppercase tracking-wider text-[var(--color-text-3)]">full feature</p>
        </div>
        <div class="bg-[var(--color-bg)] px-4 py-6">
          <p class="display text-3xl text-[var(--color-accent)]">{LANGUAGE_STATS.dictionariesStaged}</p>
          <p class="mt-1 text-xs uppercase tracking-wider text-[var(--color-text-3)]">dictionaries staged</p>
        </div>
        <div class="bg-[var(--color-bg)] px-4 py-6">
          <p class="display text-3xl text-[var(--color-accent)]">{LANGUAGE_STATS.detectionLanguages}</p>
          <p class="mt-1 text-xs uppercase tracking-wider text-[var(--color-text-3)]">auto-detected</p>
        </div>
      </div>
      <p class="mt-8 text-center text-sm">
        <a href="/languages" class="text-[var(--color-accent)] hover:underline">The full support matrix →</a>
      </p>
    </div>
  </section>

  <!-- Principles -->
  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-24">
      <SectionHeading
        jp="思想"
        eyebrow="Principles"
        title="How Kotoshu is built"
      />
      <div class="mt-12 grid gap-8 md:grid-cols-2">
        {[
          {
            jp: '純粋',
            title: 'Pure Ruby',
            body: 'No shelling out to hunspell or aspell. The only native dependency is the optional onnxruntime — everything else is Ruby that ships in the gem.',
          },
          {
            jp: '段階',
            title: 'Two-stage resources',
            body: 'Setup is explicit and downloads once; the hot path is cache-only and raises instead of ever touching the network. Metered and air-gapped hosts are safe.',
          },
          {
            jp: '意味',
            title: 'Semantic when you want it',
            body: 'FastText embeddings via ONNX rerank candidates by context and rescue out-of-vocabulary words. Install onnxruntime to enable; everything works without it.',
          },
          {
            jp: '万国',
            title: 'Every language, on demand',
            body: 'Given any text, Kotoshu detects the language and resolves the dictionary, frequency list, and model it needs — cached, verified, with TTLs.',
          },
        ].map((item, i) => (
          <div class="flex gap-5 animate-in" style={`transition-delay:${i * 60}ms`}>
            <span class="kanji shrink-0 text-xl text-[var(--color-accent)]" lang="ja" aria-hidden="true">{item.jp}</span>
            <div>
              <h3 class="text-base font-semibold text-[var(--color-text)]">{item.title}</h3>
              <p class="mt-2 text-sm leading-7 text-[var(--color-text-2)]">{item.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-inset)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-20 text-center">
      <p class="kanji text-sm text-[var(--color-accent)]" lang="ja">始めましょう</p>
      <h2 class="display mt-3 text-3xl sm:text-4xl text-[var(--color-text)]">Install the checker, or try it in the browser first.</h2>
      <div class="mt-8 flex items-center justify-center gap-6 text-sm">
        <a href="/install" class="rounded-full bg-[var(--color-accent)] px-5 py-2 font-medium text-[var(--color-bg)] transition-colors hover:bg-[var(--color-accent-hover)]">
          Install & quickstart
        </a>
        <a href="/about" class="text-[var(--color-text-2)] hover:text-[var(--color-accent)] transition-colors">
          Why “Kotoshu”? →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Signature moment: the headline misspells one word, then mends it —
  // once. Progressive enhancement: without JS the headline is already
  // correct; with reduced motion the performance is skipped entirely.
  const mend = document.getElementById('hero-mend')
  if (mend && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const correct = 'embellishing'
    const typo = 'embelishing'
    mend.classList.add('mend-typo')
    mend.textContent = typo
    setTimeout(() => {
      mend.textContent = correct
      mend.classList.remove('mend-typo')
      mend.classList.add('mend-done')
      setTimeout(() => mend.classList.remove('mend-done'), 1600)
    }, 1200)
  }
</script>
