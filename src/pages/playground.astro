---
import BaseLayout from '~/layouts/BaseLayout.astro'
import VerticalAccent from '~/components/VerticalAccent.astro'
import SectionHeading from '~/components/SectionHeading.astro'
import { PLAYGROUND_LANGUAGES } from '~/data/languages'
---

<BaseLayout
  title="Playground"
  description="Try the Kotoshu engine in your browser — zero install. The wasm engine and a Hunspell dictionary load once from a CDN and checking runs entirely on this page."
>
  <section class="relative overflow-hidden">
    <div class="zen-glow" aria-hidden="true"></div>
    <VerticalAccent text="実験" />
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-20 pb-12">
      <SectionHeading
        jp="見本"
        eyebrow="Playground"
        title="Nothing installs. It checks."
        lead="The real engine — the same Rust core the gem and the SDKs use — compiled to WebAssembly, fetched once from a CDN, running on this page. Your text never leaves the browser."
      />
      <p class="mx-auto mt-6 max-w-2xl text-center text-xs leading-6 text-[var(--color-text-3)]">
        Against your own instance instead? The <a href="/playground/server" class="text-[var(--color-accent)] hover:underline">server playground</a>
        wraps a live kotoshu-server with document checking and language detection.
      </p>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-12">
      <div class="overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-bg)]">
        <!-- Toolbar -->
        <div class="flex flex-wrap items-center gap-3 border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-inset)] px-4 py-2.5">
          <label class="flex items-center gap-2 text-xs text-[var(--color-text-2)]">
            <span class="font-mono uppercase tracking-[0.14em] text-[var(--color-text-3)]">lang</span>
            <select
              id="lab-lang"
              class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-1 font-mono text-xs text-[var(--color-text)]"
            >
              {PLAYGROUND_LANGUAGES.map((l) => (
                <option value={l.code} selected={l.code === 'en'}>
                  {l.native} · {l.code}{l.mb ? ` · ${l.mb}` : ''}
                </option>
              ))}
            </select>
          </label>
          <span
            id="lab-tier"
              class="rounded-full bg-[var(--color-gold-soft)] px-2 py-0.5 font-mono text-[10px] font-medium uppercase tracking-wider text-[var(--color-gold)]"
            title="Dictionary engine by default. The semantic switch opts this language into the mini embedding tier - about 3 MB, fetched once from the models registry mirror - to reorder suggestions by context fit."
          >
            <span lang="ja">辞書</span> tier: dictionary
          </span>
          <label
              class="flex items-center gap-1.5 text-xs text-[var(--color-text-2)]"
              title="Opt in per language: loads the mini embedding tier - about 3 MB from the models registry mirror - and reranks suggestion candidates by their fit to the surrounding text. Off by default; the dictionary tier is untouched, and a failed load degrades to dictionary-only."
            >
              <input id="lab-semantic" type="checkbox" class="size-3 accent-[var(--color-accent)]" />
              <span class="font-mono uppercase tracking-[0.14em] text-[var(--color-text-3)]">semantic</span>
              <span class="font-mono text-[10px] text-[var(--color-text-3)]">~3 MB</span>
            </label>
            <span id="lab-readout" class="ml-auto min-h-4 font-mono text-[10.5px] leading-4 tracking-wide text-[var(--color-text-3)]" aria-live="polite"></span>
        </div>

        <!-- Load progress: spinner + byte-accurate bar while any
             artifact streams (engine, dictionary, semantic pair) -->
        <div id="lab-progress" class="hidden items-center gap-2.5 border-b border-[var(--color-border-subtle)] bg-[var(--color-bg-inset)] px-4 py-2">
          <span id="lab-progress-spinner" class="lab-spinner size-3.5 shrink-0" aria-hidden="true"></span>
          <div class="h-1 min-w-0 flex-1 overflow-hidden rounded-full bg-[var(--color-border)]">
            <div id="lab-progress-fill" class="h-full w-0 rounded-full bg-[var(--color-gold)] transition-[width] duration-150"></div>
          </div>
          <span id="lab-progress-label" class="shrink-0 font-mono text-[10px] text-[var(--color-text-3)]"></span>
        </div>

        <!-- Editor + misspellings pane: the pane lists every flagged word
             with suggestions, so nothing hides behind a click -->
        <div class="grid gap-4 md:grid-cols-[minmax(0,1fr)_15rem]">
        <div class="min-w-0">
        <!-- Editor: the backdrop renders decorated text, the textarea sits on top -->
        <div id="lab-wrap" class="relative">
          <div
            id="lab-backdrop"
            class="lab-editor pointer-events-none absolute inset-0 overflow-hidden text-[var(--color-text)]"
            aria-hidden="true"
          ></div>
          <textarea
            id="lab-text"
            class="lab-editor relative h-72 w-full resize-none border-0 bg-transparent text-transparent caret-[var(--color-text)] outline-none"
            spellcheck="false"
            autocorrect="off"
            autocapitalize="off"
            aria-label="Text to check"
          >The quick brown fox jumps over the lazy dog. Teh sentence has a few mispellings to mend — try recieve, definately, wrold.</textarea>

          <!-- Suggestion popover — inside the wrap so it positions and clips with the editor -->
          <div
            id="lab-pop"
            class="pointer-events-none absolute z-20 hidden min-w-40 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-raised)] p-1.5 shadow-lg shadow-black/10"
            role="listbox"
            aria-label="Suggestions"
          >
            <p class="px-2 pb-1 pt-0.5 font-mono text-[10px] uppercase tracking-[0.14em] text-[var(--color-text-3)]">
              <span id="lab-pop-word"></span> — suggestions
            </p>
            <div id="lab-pop-list" class="max-h-56 overflow-y-auto"></div>
          </div>
        </div>

        <!-- Status -->
        <div class="flex items-center gap-2 border-t border-[var(--color-border-subtle)] bg-[var(--color-bg-inset)] px-4 py-2">
          <span id="lab-dot" class="size-1.5 shrink-0 rounded-full bg-[var(--color-text-3)]" aria-hidden="true"></span>
          <p id="lab-status" class="font-mono text-[11px] leading-5 text-[var(--color-text-3)]" aria-live="polite">loading engine…</p>
        </div>
        </div>

        <aside id="lab-pane" class="flex max-h-[21.5rem] flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-inset)] md:max-h-none" aria-label="Misspellings">
          <p class="flex items-baseline justify-between border-b border-[var(--color-border-subtle)] px-3.5 py-2">
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-text-3)]"><span class="jp" lang="ja">誤記</span> misspellings</span>
            <span id="lab-pane-count" class="font-mono text-[10px] text-[var(--color-text-3)]"></span>
          </p>
          <ol id="lab-pane-list" class="flex-1 divide-y divide-[var(--color-border-subtle)] overflow-y-auto"></ol>
        </aside>
        </div>
      </div>
      <p class="mt-4 text-center text-xs leading-6 text-[var(--color-text-3)]">
        Engine <a href="https://www.npmjs.com/package/@kotoshu/wasm/v/0.3.1" class="text-[var(--color-accent)] hover:underline">@kotoshu/wasm 0.3.1</a>
        · dictionaries from the <a href="https://github.com/kotoshu/dictionaries" class="text-[var(--color-accent)] hover:underline">dictionaries repo</a>,
        commit-pinned · both via jsDelivr, cached by your browser. The semantic tier, when you opt in, loads from the <a href="https://github.com/kotoshu/models-fasttext-onnx" class="text-[var(--color-accent)] hover:underline">models registry</a> mirror.
      </p>
    </div>
  </section>

  <!-- What this demo is, honestly -->
  <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-inset)]">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
      <p class="dict-banner"><span lang="ja">注記</span> specimen notes</p>
      <div class="mt-6">
        <div class="dict-entry">
          <span class="dict-headword">tier</span>
          <div>
            <p class="dict-sense">Dictionary engine, semantic opt-in <span class="pos">n.</span> — suggestions from edit distance, phonetics, keyboard proximity, and n-grams; the semantic switch reranks them by context fit.</p>
            <p class="dict-anno">Since @kotoshu/wasm 0.3.0 the engine itself sweeps with the Damerau operations — an adjacent swap costs one step, so Teh suggests The at rank one — and generates candidates from the model: loadModel plus rerank plus semanticSuggest, with registry v1.3.0 mirroring every mini tier to a host browsers may fetch. The switch above loads this language tier, about 3 MB, and reranks inside the worker. The <a href="/playground/server" class="text-[var(--color-accent)] hover:underline">server playground</a> still runs the heavier fluency tier and the full pipeline.</p>
          </div>
        </div>
        <div class="dict-entry">
          <span class="dict-headword">langs</span>
          <div>
            <p class="dict-sense">Thirty-three languages <span class="pos">n.</span> — every Hunspell dictionary the pinned CDN commit carries under ~5 MB, from Български to Tiếng Việt, Norsk bokmål included via the flat layout.</p>
            <p class="dict-anno">Over the budget and staying gem-only for now: el, ko, tr, uk, he (5.8–19 MB each). Japanese and Chinese are absent at any size — CJK checking rides on the gem's tokenizer, not on Hunspell files. The biggest entries carry their size in the list. See the <a href="/languages" class="text-[var(--color-accent)] hover:underline">language matrix</a>.</p>
          </div>
        </div>
        <div class="dict-entry">
          <span class="dict-headword">speed</span>
          <div>
            <p class="dict-sense">Underlines as you type <span class="pos">n.</span> — word lookups are instant; the engine runs in a Web Worker so typing never blocks.</p>
            <p class="dict-anno">Ranked suggestions sweep the dictionary, so they appear on click — the status line counts the pane sweeps done-of-total and the popover counts elapsed time, so the wait is never a blank. Usually under a second for English, slower for very long or garbled words.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type Suggestion = { word: string; distance: number; confidence: number; source: string }

  // Same token definition as the worker — the two must agree.
  const WORD_RE = /[\p{L}\p{M}]+(?:['’][\p{L}\p{M}]+)*/gu

  const el = {
    lang: document.getElementById('lab-lang') as HTMLSelectElement,
    backdrop: document.getElementById('lab-backdrop')!,
    paneCount: document.getElementById('lab-pane-count')!,
    progress: document.getElementById('lab-progress')!,
    progressFill: document.getElementById('lab-progress-fill')!,
    progressLabel: document.getElementById('lab-progress-label')!,
    paneList: document.getElementById('lab-pane-list')!,
    text: document.getElementById('lab-text') as HTMLTextAreaElement,
    wrap: document.getElementById('lab-wrap')!,
    pop: document.getElementById('lab-pop')!,
    popWord: document.getElementById('lab-pop-word')!,
    popList: document.getElementById('lab-pop-list')!,
    status: document.getElementById('lab-status')!,
    dot: document.getElementById('lab-dot')!,
    readout: document.getElementById('lab-readout')!,
    tier: document.getElementById('lab-tier')!,
    semantic: document.getElementById('lab-semantic') as HTMLInputElement,
  }

  const worker = new Worker(
    new URL('../components/playground/engine-worker.ts', import.meta.url),
    { type: 'module' },
  )

  let misspelled = new Set<string>()
  let debounce: ReturnType<typeof setTimeout> | undefined
  let popRange: { start: number; end: number } | null = null
  // Semantic layer state, mirrored from the worker semantic-status posts.
  let semanticWanted = false
  let semanticReady = false
  let langLoaded: string | null = null
  let engineBytes = 0
  let dictBytes = 0
  let modelBytes = 0
  let engineVersion = '…'
  let engineFromCache = false
  let dictFromCache = false
  let modelFromCache = false

  const kib = (n: number) => `${Math.max(1, Math.round(n / 1024))} KiB`
  let progressHideTimer = 0

  // The idle line the status returns to whenever no load or sweep is in
  // flight — the misspelling count once checking has run.
  let idleStatus = 'loading engine…'
  const PHASE_LABEL: Record<string, string> = {
    engine: 'engine',
    dictionary: 'dictionary',
    semantic: 'semantic',
  }
  const setStatus = (text: string, busy = false) => {
    el.status.textContent = text
    el.dot.classList.toggle('lab-dot-busy', busy)
  }
  // The readout is the inventory: exactly what is resident in this
  // tab, where each artifact came from, and how big it is.
  const updateReadout = () => {
    const src = (cached: boolean) => (cached ? 'cache' : 'net')
    el.readout.title = el.readout.textContent
    el.readout.textContent =
      `${engineVersion} [${src(engineFromCache)}]` +
      (langLoaded ? ` · ${langLoaded} dict ${kib(dictBytes)} [${src(dictFromCache)}]` : '') +
      (semanticReady && modelBytes ? ` · mini ${kib(modelBytes)} [${src(modelFromCache)}]` : '')
  }

  // — engine wiring ——————————————————————————————

  function load(lang: string) {
    el.status.textContent = `loading ${lang} — engine + dictionary…`
    el.dot.style.background = 'var(--color-gold)'
    worker.postMessage({ type: 'load', lang })
  }

  worker.addEventListener('message', (event: MessageEvent) => {
    const m = event.data as {
      type: string
      lang?: string
      words?: string[]
      word?: string
      suggestions?: Suggestion[]
      engineBytes?: number
      dictionaryBytes?: number
      engineVersion?: string
      loadMs?: number
      message?: string
      state?: 'off' | 'loading' | 'ready' | 'unavailable'
      modelBytes?: number
      detail?: string
      engineCached?: boolean
      dictCached?: boolean
      modelCached?: boolean
      kind?: string
      phase?: string
      loaded?: number
      total?: number
      ms?: number
      sweepMs?: number
      semanticMs?: number
      rerankMs?: number
      semantic?: boolean
      wasmVersion?: string
    }

    if (m.type === 'load-progress') {
      const loaded = m.loaded ?? 0
      const total = m.total ?? 0
      const unknown = total === 0
      el.progress.classList.remove('hidden')
      el.progress.classList.add('flex')
      const pct = unknown ? 100 : Math.min(100, (loaded / total) * 100)
      el.progressFill.style.width = `${pct.toFixed(1)}%`
      el.progressFill.classList.toggle('lab-progress-indet', unknown)
      const phase = PHASE_LABEL[m.phase ?? ''] ?? 'load'
      el.progressLabel.textContent =
        `${phase} · ${m.kind ?? ''} ` +
        (unknown ? `${kib(loaded)} · ?` : `${kib(loaded)} / ${kib(total)}`)
      clearTimeout(progressHideTimer)
      progressHideTimer = window.setTimeout(() => {
        el.progress.classList.add('hidden')
        el.progress.classList.remove('flex')
      }, 1200)
    } else if (m.type === 'loaded') {
      misspelled = new Set()
      langLoaded = m.lang ?? null
      engineBytes = m.engineBytes ?? 0
      dictBytes = m.dictionaryBytes ?? 0
      engineVersion = `engine ${m.engineVersion ?? ''}`.trim()
      engineFromCache = m.engineCached ?? false
      dictFromCache = m.dictCached ?? false
      // The package pin is what the CDN serves; the engine constant is the
      // kotoshu crate version inside it — both shown so neither misleads.
      if (m.wasmVersion) engineVersion = `wasm ${m.wasmVersion} · ${engineVersion}`
      el.status.textContent =
        `engine ${m.engineVersion} ready — ${m.lang} loaded in ${m.loadMs} ms` +
        (m.dictCached ? ' (dictionary from cache)' : '')
      el.dot.style.background = 'var(--color-accent)'
      el.dot.classList.remove('lab-dot-busy')
      idleStatus = el.status.textContent
      updateReadout()
      scheduleCheck(0)
      // The checkbox survives language switches - re-request the new
      // language tier right after its dictionary lands.
      if (semanticWanted) worker.postMessage({ type: 'semantic', lang: el.lang.value, enable: true })
    } else if (m.type === 'semantic-status') {
      if (m.state === 'ready') {
        semanticReady = true
        modelBytes = m.modelBytes ?? 0
        modelFromCache = m.modelCached ?? false
        el.tier.innerHTML = '<span lang="ja">辞書</span> tier: dictionary + semantic'
        el.tier.title = 'Semantic reranking on - candidates are reordered by the mini embedding tier running in the worker.'
        el.status.textContent = `semantic reranking on — ${m.lang} mini tier resident, ${kib(modelBytes)}`
        idleStatus = el.status.textContent
        updateReadout()
      } else if (m.state === 'loading') {
        el.tier.innerHTML = '<span lang="ja">辞書</span> tier: dictionary + semantic…'
        el.status.textContent = `loading ${m.lang} semantic model — mini tier, about 3 MB…`
      } else if (m.state === 'unavailable') {
        semanticReady = false
        modelBytes = 0
        el.tier.innerHTML = '<span lang="ja">辞書</span> tier: dictionary'
        el.tier.title = 'Semantic model unavailable - mirror unreachable or no mini tier for this language. Dictionary-only.'
        el.status.textContent = `semantic model unavailable — ${m.detail ?? 'mirror unreachable'} · dictionary-only`
        idleStatus = el.status.textContent
        updateReadout()
      } else if (semanticReady || modelBytes > 0) {
        semanticReady = false
        modelBytes = 0
        el.tier.innerHTML = '<span lang="ja">辞書</span> tier: dictionary'
        el.status.textContent = 'semantic reranking off — model memory freed'
        idleStatus = el.status.textContent
        updateReadout()
      }
    } else if (m.type === 'load-error') {
      el.status.textContent = `offline or blocked — ${m.message}`
      el.status.appendChild(retryButton())
      el.dot.style.background = '#c0392b'
    } else if (m.type === 'checked') {
      misspelled = new Set(m.words ?? [])
      const n = misspelled.size
      idleStatus =
        n === 0
          ? `no misspellings · ${m.ms ?? 0} ms`
          : `${n} misspelled · ${m.ms ?? 0} ms`
      updateSuggestStatus()
      render()
      renderPane()
    } else if (m.type === 'suggested') {
      const timing = {
        sweepMs: m.sweepMs ?? 0,
        semanticMs: m.semanticMs ?? 0,
        rerankMs: m.rerankMs ?? 0,
        semantic: m.semantic ?? false,
      }
      if (popRange && el.popWord.textContent === m.word) renderSuggestions(m.suggestions ?? [], timing)
      if (paneRequests.has(m.word ?? '')) {
        paneRequests.delete(m.word ?? '')
        paneDone++
        fillPaneItem(m.word ?? '', m.suggestions ?? [])
        updateSuggestStatus()
      }
    }
  })

  function retryButton() {
    const btn = document.createElement('button')
    btn.textContent = 'retry'
    btn.className = 'ml-2 rounded border border-[var(--color-border)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--color-accent)] hover:border-[var(--color-accent)]'
    btn.addEventListener('click', () => {
      btn.remove()
      load(el.lang.value)
    })
    return btn
  }

  // — checking ——————————————————————————————————

  function scheduleCheck(delay = 150) {
    clearTimeout(debounce)
    debounce = setTimeout(() => {
      setStatus(`checking text…`, true)
      worker.postMessage({ type: 'check', text: el.text.value })
    }, delay)
  }

  function render() {
    hidePopover()
    const frag = document.createDocumentFragment()
    let last = 0
    for (const match of el.text.value.matchAll(WORD_RE)) {
      const [word] = match
      const start = match.index ?? 0
      const end = start + word.length
      if (!misspelled.has(word) && !misspelled.has(word.toLowerCase())) continue
      frag.append(document.createTextNode(el.text.value.slice(last, start)))
      const span = document.createElement('span')
      span.className = 'misspelled'
      span.dataset.start = String(start)
      span.dataset.end = String(end)
      span.textContent = word
      frag.append(span)
      last = end
    }
    frag.append(document.createTextNode(el.text.value.slice(last)))
    el.backdrop.replaceChildren(frag)
    // Underlines may push nothing (decoration only) — sync scroll anyway.
    el.backdrop.scrollTop = el.text.scrollTop
  }

  // — misspellings pane ————————————————————————

  let paneRequests = new Set<string>()
  let paneTotal = 0
  let paneDone = 0

  // The status line while the pane fills: how many sweeps are back. Falls
  // back to the idle line (misspelling count) when the queue drains.
  function updateSuggestStatus() {
    if (paneTotal > 0 && paneDone < paneTotal) {
      setStatus(`suggesting — ${paneDone}/${paneTotal} words…`, true)
    } else {
      setStatus(idleStatus)
    }
  }

  function renderPane() {
    el.paneList.replaceChildren()
    const spans = [...el.backdrop.querySelectorAll<HTMLElement>('.misspelled')]
    el.paneCount.textContent = spans.length === 0 ? '' : String(spans.length)
    if (spans.length === 0) {
      const p = document.createElement('p')
      p.className = 'px-3.5 py-3 font-mono text-[11px] text-[var(--color-text-3)]'
      p.textContent = 'nothing misspelled'
      el.paneList.append(p)
      paneTotal = 0
      paneDone = 0
      return
    }
    const text = el.text.value
    paneRequests.clear()
    const batch: { word: string; context: string }[] = []
    for (const span of spans) {
      const word = span.textContent ?? ''
      const start = Number(span.dataset.start)
      const line = text.slice(0, start).split('\n').length
      const li = document.createElement('li')
      li.className = 'lab-pane-item px-3.5 py-2.5'
      li.dataset.word = word
      li.dataset.start = String(start)
      const head = document.createElement('p')
      head.className = 'flex items-baseline gap-2'
      const w = document.createElement('span')
      w.className = 'lab-pane-word font-mono text-[12.5px] text-[var(--color-text)]'
      w.textContent = word
      const ln = document.createElement('span')
      ln.className = 'ml-auto font-mono text-[10px] text-[var(--color-text-3)]'
      ln.textContent = `line ${line}`
      head.append(w, ln)
      const senses = document.createElement('div')
      senses.className = 'mt-1 flex flex-wrap gap-1.5'
      senses.dataset.role = 'senses'
      li.append(head, senses)
      li.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).dataset.role === 'mend') return
        jumpToWord(start)
      })
      el.paneList.append(li)
      if (paneRequests.size < 12 && !paneRequests.has(word)) {
        paneRequests.add(word)
        // A live sweep indicator per item — the worker sweeps the batch
        // one word at a time, so this is where the wait is visible.
        const spin = document.createElement('span')
        spin.className = 'lab-spinner size-2.5 shrink-0'
        const lbl = document.createElement('span')
        lbl.className = 'font-mono text-[10.5px] text-[var(--color-text-3)]'
        lbl.textContent = 'sweeping…'
        senses.append(spin, lbl)
        batch.push({ word, context: contextWindow(start) })
      } else if (paneRequests.size >= 12 && !paneRequests.has(word)) {
        // Beyond the request cap: the word is still flagged and clickable
        // — the popover sweeps it on click — but no spinner, because no
        // sweep is coming for this row.
        const lbl = document.createElement('span')
        lbl.className = 'font-mono text-[10.5px] text-[var(--color-text-3)]'
        lbl.textContent = '· · ·'
        lbl.title = 'suggestions here are capped at 12 words — click the word in the editor for its full sweep'
        senses.append(lbl)
      }
    }
    paneTotal = paneRequests.size
    paneDone = 0
    // One message for the whole pane - a single pass through the queue,
    // not one round-trip per word. A popover click still jumps ahead.
    if (batch.length > 0) worker.postMessage({ type: 'suggest-batch', items: batch })
    updateSuggestStatus()
  }

  function fillPaneItem(word: string, suggestions: Suggestion[]) {
    // One word can sit in several rows (duplicates) — fill them all.
    const rows = [...el.paneList.querySelectorAll<HTMLElement>(`li[data-word="${CSS.escape(word)}"]`)]
    for (const li of rows) {
      const senses = li.querySelector<HTMLElement>('[data-role="senses"]')!
      senses.replaceChildren()
      senses.className =
        suggestions.length === 0
          ? 'mt-1 font-mono text-[10.5px] text-[var(--color-text-3)]'
          : 'mt-1 flex flex-wrap gap-1.5'
      if (suggestions.length === 0) {
        senses.textContent = 'no suggestions'
        continue
      }
      for (const s of suggestions.slice(0, 3)) {
        const btn = document.createElement('button')
        btn.className =
          'rounded-md border border-[var(--color-border)] px-1.5 py-0.5 font-mono text-[11px] text-[var(--color-accent)] hover:border-[var(--color-accent)]'
        btn.dataset.role = 'mend'
        btn.textContent = s.word
        btn.addEventListener('click', () => {
          const start = Number(li.dataset.start ?? 0)
          const span = spanAt(start)
          if (!span) return
          popRange = { start, end: start + word.length }
          apply(s.word)
        })
        senses.append(btn)
      }
    }
  }

  function jumpToWord(start: number) {
    const span = spanAt(start)
    if (!span) return
    const text = el.text.value
    const line = text.slice(0, start).split('\n').length
    const lineHeight = 0.875 * 16 * 1.75
    el.text.scrollTop = Math.max(0, (line - 3) * lineHeight)
    el.backdrop.scrollTop = el.text.scrollTop
    el.text.focus()
    el.text.setSelectionRange(start, start)
    span.classList.remove('lab-pane-flash')
    void span.offsetWidth // restart the animation
    span.classList.add('lab-pane-flash')
    setTimeout(() => span.classList.remove('lab-pane-flash'), 950)
  }

  // — popover ——————————————————————————————————

  function hidePopover() {
    el.pop.classList.add('hidden')
    el.pop.classList.add('pointer-events-none')
    el.pop.classList.remove('pointer-events-auto')
    popRange = null
    stopPopTicker()
  }

  function showPopoverFor(span: HTMLElement) {
    popRange = { start: Number(span.dataset.start), end: Number(span.dataset.end) }
    const word = span.textContent ?? ''
    el.popWord.textContent = word
    el.popList.replaceChildren(thinkingRow(word))
    positionPopover(span)
    setStatus(`sweeping for ${word}…`, true)
    worker.postMessage({ type: 'suggest', word, context: contextWindow(popRange.start) })
  }

  // The +/-3-token window around the misspelling - the gem's
  // surrounding_words(3), the only context the boost ever sees.
  function contextWindow(start: number): string {
    const tokens = [...el.text.value.matchAll(WORD_RE)]
    const i = tokens.findIndex((match) => (match.index ?? 0) === start)
    if (i < 0) return ''
    return tokens.slice(Math.max(0, i - 3), i + 4).map((match) => match[0]).join(' ')
  }

  // The sweep can take real time (dictionary-wide); the ticker keeps the
  // wait visibly alive instead of a static ellipsis.
  let popTicker = 0

  function stopPopTicker() {
    if (popTicker) clearInterval(popTicker)
    popTicker = 0
  }

  function thinkingRow(word: string) {
    const p = document.createElement('p')
    p.className = 'px-2 py-1.5 font-mono text-[11px] text-[var(--color-text-3)]'
    p.textContent = `sweeping for ${word}…`
    const t0 = performance.now()
    stopPopTicker()
    popTicker = window.setInterval(() => {
      p.textContent = `sweeping for ${word}… ${Math.round(performance.now() - t0)} ms`
    }, 100)
    return p
  }

  interface SuggestTiming {
    sweepMs: number
    semanticMs: number
    rerankMs: number
    semantic: boolean
  }

  function timingFooter(t: SuggestTiming) {
    const parts: string[] = []
    if (t.sweepMs) parts.push(`sweep ${t.sweepMs} ms`)
    if (t.semantic) parts.push(`semantic ${t.semanticMs} ms · rerank ${t.rerankMs} ms`)
    if (parts.length === 0) return null
    const p = document.createElement('p')
    p.className = 'border-t border-[var(--color-border-subtle)] px-2 pb-1 pt-1.5 font-mono text-[9.5px] text-[var(--color-text-3)]'
    p.textContent = parts.join(' · ')
    return p
  }

  function positionPopover(span: HTMLElement) {
    el.pop.classList.remove('hidden')
    el.pop.classList.remove('pointer-events-none')
    el.pop.classList.add('pointer-events-auto')
    const wrapBox = el.wrap.getBoundingClientRect()
    const spanBox = span.getBoundingClientRect()
    const left = Math.min(
      Math.max(0, spanBox.left - wrapBox.left),
      Math.max(0, el.wrap.clientWidth - 220),
    )
    // Flip above the word when there is no room below the editor edge.
    const below = spanBox.bottom - wrapBox.top + 6
    const popHeight = el.pop.offsetHeight || 140
    const top =
      below + popHeight <= el.wrap.clientHeight ? below : Math.max(0, spanBox.top - wrapBox.top - popHeight - 6)
    el.pop.style.top = `${top}px`
    el.pop.style.left = `${left}px`
  }

  function renderSuggestions(suggestions: Suggestion[], timing?: SuggestTiming) {
    if (!popRange) return
    stopPopTicker()
    el.popList.replaceChildren()
    if (suggestions.length === 0) {
      const none = document.createElement('p')
      none.className = 'px-2 py-1.5 font-mono text-[11px] text-[var(--color-text-3)]'
      none.textContent = 'no suggestions'
      el.popList.append(none)
    }
    for (const s of suggestions) {
      const btn = document.createElement('button')
      btn.className =
        'flex w-full items-baseline justify-between gap-3 rounded-md px-2 py-1.5 text-left text-[13px] text-[var(--color-text)] hover:bg-[var(--color-accent-soft)] hover:text-[var(--color-accent)]'
      btn.setAttribute('role', 'option')
      const word = document.createElement('span')
      word.textContent = s.word
      const meta = document.createElement('span')
      meta.className = 'font-mono text-[10px] text-[var(--color-text-3)]'
      meta.textContent = `${s.source} ${s.confidence.toFixed(2)}`
      btn.append(word, meta)
      btn.addEventListener('click', () => apply(s.word))
      el.popList.append(btn)
    }
    const footer = timing ? timingFooter(timing) : null
    if (footer) el.popList.append(footer)
    setStatus(idleStatus)
  }

  function apply(replacement: string) {
    if (!popRange) return
    const { start, end } = popRange
    el.text.value = el.text.value.slice(0, start) + replacement + el.text.value.slice(end)
    hidePopover()
    el.text.focus()
    el.text.setSelectionRange(start + replacement.length, start + replacement.length)
    scheduleCheck(0)
  }

  // — events ———————————————————————————————————

  el.text.addEventListener('input', () => {
    hidePopover()
    scheduleCheck()
  })

  el.text.addEventListener('scroll', () => {
    el.backdrop.scrollTop = el.text.scrollTop
    el.backdrop.scrollLeft = el.text.scrollLeft
    hidePopover()
  })

  el.text.addEventListener('click', () => {
    const caret = el.text.selectionStart ?? 0
    const span = spanAt(caret)
    if (span) {
      showPopoverFor(span)
    } else {
      hidePopover()
    }
  })

  el.text.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') hidePopover()
  })

  function spanAt(caret: number): HTMLElement | null {
    const spans = el.backdrop.querySelectorAll<HTMLElement>('.misspelled')
    for (const span of spans) {
      const start = Number(span.dataset.start)
      const end = Number(span.dataset.end)
      if (caret >= start && caret <= end) return span
    }
    return null
  }

  el.lang.addEventListener('change', () => {
    hidePopover()
    misspelled = new Set()
    render()
    load(el.lang.value)
  })
  el.semantic.addEventListener('change', () => {
    semanticWanted = el.semantic.checked
    if (semanticWanted) {
      if (langLoaded) worker.postMessage({ type: 'semantic', lang: el.lang.value, enable: true })
    } else {
      worker.postMessage({ type: 'semantic', enable: false })
    }
  })

  document.addEventListener('click', (event) => {
    if (event.target instanceof Node && !el.pop.contains(event.target) && event.target !== el.text) {
      hidePopover()
    }
  })

  // Default to the reader's language when we serve it.
  const preferred = (navigator.languages ?? [navigator.language]).map((l) => l.split('-')[0])
  const match = preferred.find((l) => [...el.lang.options].some((o) => o.value === l))
  if (match) el.lang.value = match

  render()
  load(el.lang.value)
</script>
