---
import BaseLayout from '~/layouts/BaseLayout.astro'
import VerticalAccent from '~/components/VerticalAccent.astro'
import SectionHeading from '~/components/SectionHeading.astro'
import InstallTabs from '~/components/home/InstallTabs.vue'

interface Channel {
  /** mono headword — the short channel name */
  code: string
  /** jp accent for the row */
  jp: string
  name: string
  note: string
  command: string
  docs?: { label: string; href: string }
}

const channels: Channel[] = [
  {
    code: 'ruby',
    jp: '宝石',
    name: 'Ruby — library & CLI',
    note: 'The reference gem (1.0.1): two-stage resources, model tiers, 35 full-feature languages, optional native extension.',
    command: 'gem install kotoshu',
    docs: { label: 'Ruby API', href: '/docs/api' },
  },
  {
    code: 'python',
    jp: '蛇',
    name: 'Python — client + native engine',
    note: 'kotoshu 0.1.0 over HTTP; kotoshu-native 0.1.0 embeds the Rust engine for offline checking.',
    command: 'pip install kotoshu kotoshu-native',
    docs: { label: 'Python client', href: '/docs/clients/python' },
  },
  {
    code: 'js',
    jp: '波',
    name: 'JavaScript & TypeScript — client + wasm',
    note: '@kotoshu/client 0.1.0 for Node, Deno, Bun, browsers; @kotoshu/wasm 1.0.0 runs the engine in-process with loadPack language packs.',
    command: 'npm install @kotoshu/client',
    docs: { label: 'JavaScript client', href: '/docs/clients/javascript' },
  },
  {
    code: 'rust',
    jp: '錆',
    name: 'Rust — the engine itself',
    note: 'The kotoshu crate 0.1.0: dictionaries, ranked suggestions, the C ABI batch format.',
    command: 'cargo add kotoshu',
    docs: { label: 'Rust engine', href: '/docs/clients/rust' },
  },
  {
    code: 'go',
    jp: '囲碁',
    name: 'Go — HTTP client',
    note: 'kotoshu-go v0.1.0: context-aware check, suggest, detect, correct.',
    command: 'go get github.com/kotoshu/kotoshu-go@v0.1.0',
    docs: { label: 'Go client', href: '/docs/clients/go' },
  },
  {
    code: 'http',
    jp: '服務',
    name: 'HTTP — the server',
    note: 'Seven JSON endpoints (1.0.1): checking with the optional model flag, suggestions, and 176-language detection — the contract every SDK speaks.',
    command: 'gem install kotoshu-server',
    docs: { label: 'HTTP API', href: '/docs/clients/http' },
  },
  {
    code: 'lsp',
    jp: '編集',
    name: 'Editor — via LSP',
    note: 'kotoshu-lsp 0.1.1: diagnostics, quick-fixes, hover suggestions in any LSP editor, with the personal dictionary read live.',
    command: 'gem install kotoshu-lsp',
    docs: { label: 'Editor integration', href: '/docs/clients/lsp' },
  },
  {
    code: 'ci',
    jp: '検証',
    name: 'CI — GitHub Action',
    note: 'action-kotoshu v2: directory mode, CI baselines, include/exclude, and SARIF in the Security tab, with dictionaries cached between runs.',
    command: 'uses: kotoshu/action-kotoshu@v2',
    docs: { label: 'GitHub Action', href: '/docs/clients/action' },
  },
]
---

<BaseLayout title="Install & quickstart" description="Every channel to install Kotoshu — the Ruby gem, Python and JavaScript packages, the Rust crate, the Go client, the HTTP server, the editor LSP, and the GitHub Action.">
  <section class="relative overflow-hidden">
    <div class="zen-glow" aria-hidden="true"></div>
    <VerticalAccent text="導入" />
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-20 pb-16">
      <SectionHeading
        jp="導入"
        eyebrow="Install"
        title="Pick your channel"
        lead="Eight channels, one engine. The checking core has two native implementations — the Ruby gem and the Rust crate — proven byte-identical on a frozen conformance contract, and every channel below builds on one of them."
      />
      <div class="mx-auto mt-12 max-w-2xl">
        <InstallTabs
          client:visible
          tabs={[
            { id: 'python', label: 'Python', hint: 'Client + native engine', command: 'pip install kotoshu kotoshu-native' },
            { id: 'npm', label: 'npm', hint: 'Client + wasm engine', command: 'npm install @kotoshu/client @kotoshu/wasm' },
            { id: 'gem', label: 'Ruby', hint: 'Reference library & CLI', command: 'gem install kotoshu' },
            { id: 'cargo', label: 'Rust', hint: 'The engine crate', command: 'cargo add kotoshu' },
            { id: 'go', label: 'Go', hint: 'HTTP client', command: 'go get github.com/kotoshu/kotoshu-go@v0.1.0' },
            { id: 'lsp', label: 'Editor', hint: 'VS Code · Neovim · Emacs', command: 'gem install kotoshu-lsp' },
            { id: 'action', label: 'GitHub Action', hint: 'SARIF in the Security tab', command: 'uses: kotoshu/action-kotoshu@v2' },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- Engines and bindings — why every channel is first class -->
  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
      <p class="dict-banner animate-in"><span lang="ja">機関</span> engines and bindings</p>
      <p class="mt-6 text-[15px] leading-8 text-[var(--color-text-2)]">
        Every channel above is a first-class client, and four of them run the checking engine in-process.
        The engine has exactly two implementations — pure Ruby and Rust — held byte-identical by a frozen
        conformance contract that CI enforces on every change. Whichever runtime you choose, the outputs
        are the same; the difference is speed.
      </p>
      <ul class="mt-6 space-y-3 text-[15px] leading-7 text-[var(--color-text-2)]">
        <li><strong>Ruby</strong> installs the Rust engine as a precompiled native platform gem on Linux, macOS, and Windows — <code class="font-mono text-[13px] text-[var(--color-accent)]">gem install kotoshu</code> resolves it automatically on a matching machine, and the <code class="font-mono text-[13px] text-[var(--color-accent)]">auto</code> backend uses it whenever it loads. Every other platform gets the pure-Ruby gem, which is always published and needs nothing beyond Ruby itself; <code class="font-mono text-[13px] text-[var(--color-accent)]">KOTOSHU_BACKEND=native</code> or <code class="font-mono text-[13px] text-[var(--color-accent)]">=ruby</code> still forces an engine explicitly.</li>
        <li><strong>Python</strong> embeds the Rust engine through the <code class="font-mono text-[13px] text-[var(--color-accent)]">kotoshu-native</code> wheel — a Rust FFI binding — for fully offline, in-process checking; the plain <code class="font-mono text-[13px] text-[var(--color-accent)]">kotoshu</code> package speaks HTTP instead.</li>
        <li><strong>JavaScript and the browser</strong> run the Rust engine compiled to WebAssembly (<code class="font-mono text-[13px] text-[var(--color-accent)]">@kotoshu/wasm</code>), with language packs that load a whole language in one fetch.</li>
        <li><strong>Rust</strong> uses the engine crate directly.</li>
      </ul>
      <p class="mt-6 text-[15px] leading-8 text-[var(--color-text-2)]">
        Resolution is automatic and needs no compiler anywhere: a prebuilt native
        artifact installs wherever one exists for your platform — x86_64 and
        aarch64 Linux, both macOS families, and Windows — and the pure-Ruby
        implementation is the fallback everywhere else, so no install path ever
        builds anything. Python's kotoshu-native package follows the same rule
        with one wheel per platform and Python 3.10–3.13.

        Where the Rust engine is in-process it is roughly 10–15× faster on the suggestion sweep than
        optimized pure Ruby (English full dictionary: about 45 ms versus 661 ms average per suggestion),
        and it is the only option in the browser. For batch CI checking the gap barely matters — both
        engines check in milliseconds, and the conformance contract guarantees identical results either way.
      </p>
    </div>
  </section>

  <!-- Channel catalog — one dictionary entry per channel -->
  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
      <p class="dict-banner animate-in"><span lang="ja">辞書</span> the channel catalog</p>
      <div class="mt-6">
        {channels.map((c, i) => (
          <div class="dict-entry animate-in" style={`transition-delay:${Math.min(i, 5) * 40}ms`}>
            <span class="dict-headword">{c.code}</span>
            <div>
              <p class="dict-sense">
                <strong class="font-semibold">{c.name}</strong>
                <span class="kanji ml-2 text-xs text-[var(--color-accent)]" lang="ja">{c.jp}</span>
              </p>
              <p class="mt-1 text-[15px] leading-7 text-[var(--color-text-2)]">{c.note}</p>
              <pre class="code-block mt-2 overflow-x-auto px-3.5 py-2.5 text-[12.5px]"><code>{c.command}</code></pre>
              {c.docs && (
                <p class="dict-anno">
                  <a href={c.docs.href} class="text-[var(--color-accent)] hover:underline">{c.docs.label} →</a>
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--color-border)]">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16 space-y-14">
      <div class="animate-in">
        <p class="eyebrow mb-4"><span class="jp" lang="ja">最初</span>Ruby — the sixty-second path</p>
        <pre class="code-block overflow-x-auto p-4 text-[13px] leading-7"><code>gem install kotoshu

# Stage 1 — set up a language once (downloads the dictionary, ~5 MB)
kotoshu setup en

# Stage 2 — check, cache-only, instant
echo "helo wrold" | kotoshu check
kotoshu check README.md --format sarif
kotoshu check README.md --interactive</code></pre>
        <p class="mt-3 text-sm leading-7 text-[var(--color-text-2)]">
          In Ruby: <code class="font-mono text-xs text-[var(--color-accent)]">Kotoshu.setup(:en)</code>
          then <code class="font-mono text-xs text-[var(--color-accent)]">Kotoshu.check("helo wrold")</code>.
          Optional semantics: <code class="font-mono text-xs">gem install onnxruntime</code>.
          The model ships in three tiers — fluency (~15 MB, the default), full (~120 MB), or mini (~3 MB) — covered in
          <a href="/docs/caching" class="text-[var(--color-accent)] hover:underline">Caching &amp; resources</a>;
          measured check and sweep latencies are on
          <a href="/docs/performance" class="text-[var(--color-accent)] hover:underline">Performance</a>.
          Thirty-five languages have the full feature set — dictionary, semantic model,
        <p class="text-[14px] leading-6 text-[var(--color-text-3)] mt-2">Every other staged language works too on the basic tier — setup any of the 95 and check immediately; full-feature languages add keyboards and verified specimens.</p>
          keyboard layouts — and semantic models exist for 55: the counts live on
          <a href="/languages" class="text-[var(--color-accent)] hover:underline">the language matrix</a>.
          Rails validators, RSpec matchers, Rake, and Jekyll integrate with no new
          dependencies — <a href="/docs/integrations" class="text-[var(--color-accent)] hover:underline">framework integrations</a>.
          On Windows the same commands hold — CI proves Ruby 3.3, 3.4, and 4.0 on
          <code class="font-mono text-xs">windows-latest</code> — see
          <a href="/docs/windows" class="text-[var(--color-accent)] hover:underline">Kotoshu on Windows</a>.
        </p>
      </div>

      <div class="animate-in">
        <p class="eyebrow mb-4"><span class="jp" lang="ja">終焉</span>Exit codes</p>
        <div class="overflow-hidden rounded-lg border border-[var(--color-border)]">
          <table class="w-full text-sm">
            <tbody class="divide-y divide-[var(--color-border)]">
              {[
                ['0', 'No spelling errors'],
                ['1', 'Errors found'],
                ['2', 'Usage error'],
                ['3', 'Language not set up — run kotoshu setup LANG'],
              ].map(([code, meaning]) => (
                <tr>
                  <td class="w-16 px-4 py-2.5 font-mono text-[var(--color-gold)]">{code}</td>
                  <td class="px-4 py-2.5 text-[var(--color-text-2)]">{meaning}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-inset)] p-6 text-center animate-in">
        <p class="text-sm text-[var(--color-text-2)]">
          Not sure which surface is yours? The
          <a href="/audiences" class="text-[var(--color-accent)] hover:underline">audiences guide</a>
          matches how you work to what to install — every persona now links straight to its channel guide.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
