---
import BaseLayout from '~/layouts/BaseLayout.astro'
import VerticalAccent from '~/components/VerticalAccent.astro'
import SectionHeading from '~/components/SectionHeading.astro'
import { AUDIENCES } from '~/data/audiences'

const ICONS: Record<string, string> = {
  code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>',
  globe: '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  letters: '<path d="M4 7V4h16v3"/><path d="M9 20h6"/><path d="M12 4v16"/>',
}
---

<BaseLayout title="Audiences — who uses Kotoshu" description="Ruby developers, writers and editors, CI maintainers, non-Ruby teams, and multilingual writers — what each audience needs from Kotoshu and what to install.">
  <section class="relative overflow-hidden">
    <div class="zen-glow" aria-hidden="true"></div>
    <VerticalAccent text="使う人" />
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-20 pb-16">
      <SectionHeading
        jp="使う人"
        eyebrow="Audiences"
        title="Who tends words with Kotoshu"
        lead="Five audiences, five entry points. Find yourself below — each section says what you get and exactly what to install."
      />
    </div>
  </section>

  {AUDIENCES.map((a) => (
    <section id={a.id} class="scroll-mt-20 border-t border-[var(--color-border)]">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
          <div class="animate-in">
            <div class="flex items-center gap-4">
              <span class="grid size-12 place-items-center rounded-xl border border-[var(--color-border)] bg-[var(--color-bg-inset)]">
                <svg
                  class="size-5 text-[var(--color-accent)]"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={ICONS[a.icon]}
                  aria-hidden="true"
                />
              </span>
              <span class="kanji text-2xl text-[var(--color-accent)]" lang="ja" aria-hidden="true">{a.kanji}</span>
            </div>
            <h2 class="display mt-5 text-3xl text-[var(--color-text)]">{a.name}</h2>
            <p class="mt-2 text-[15px] font-medium text-[var(--color-accent)]">{a.headline}</p>
            <p class="mt-4 text-sm leading-7 text-[var(--color-text-2)]">{a.who}</p>
            <pre class="code-block mt-6 overflow-x-auto px-3.5 py-2.5 text-xs"><code>{a.install}</code></pre>
            {a.guide && (
              <p class="mt-2 font-mono text-[11px] tracking-wide text-[var(--color-text-3)]">
                <a href={a.guide.href} class="text-[var(--color-accent)] hover:underline">{a.guide.label} →</a>
              </p>
            )}
          </div>

          <div class="animate-in">
            <h3 class="text-xs font-semibold uppercase tracking-[0.18em] text-[var(--color-text-3)]">
              You need Kotoshu if…
            </h3>
            <ul class="mt-5 space-y-3.5">
              {a.needs.map((need) => (
                <li class="flex gap-3 text-sm leading-7 text-[var(--color-text-2)]">
                  <span class="mt-[13px] size-1 shrink-0 rounded-full bg-[var(--color-gold)]" aria-hidden="true"></span>
                  {need}
                </li>
              ))}
            </ul>
            <div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm">
              {a.projects.map((p) => (
                <a href={p.href} class="font-medium text-[var(--color-accent)] hover:underline">
                  {p.label} ↗
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
