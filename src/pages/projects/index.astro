---
import BaseLayout from '~/layouts/BaseLayout.astro'
import VerticalAccent from '~/components/VerticalAccent.astro'
import SectionHeading from '~/components/SectionHeading.astro'
import { PROJECTS, type ProjectStatus } from '~/data/projects'
import { AUDIENCES } from '~/data/audiences'

const audienceName = (id: string) => AUDIENCES.find((a) => a.id === id)?.name ?? id

const STATUS_STYLE: Record<ProjectStatus, string> = {
  live: 'bg-[var(--color-accent-soft)] text-[var(--color-accent)]',
  beta: 'bg-[var(--color-gold-soft)] text-[var(--color-gold)]',
  pending: 'bg-[var(--color-bg-raised)] text-[var(--color-text-3)]',
}

const groups = [
  {
    jp: '中心',
    label: 'Core',
    ids: ['kotoshu', 'kotoshu-rs'],
  },
  {
    jp: '表現',
    label: 'Surfaces — how you reach the engine',
    ids: ['kotoshu-lsp', 'kotoshu-server', 'kotoshu-python', 'kotoshu-js', 'kotoshu-go', 'action-kotoshu', 'docker-kotoshu-ci'],
  },
  {
    jp: '内容',
    label: 'Content — what the engine reads',
    ids: ['dictionaries', 'frequency-list-kelly', 'models-fasttext-onnx'],
  },
  {
    jp: '看板',
    label: 'Site',
    ids: ['kotoshu.github.io'],
  },
]
---

<BaseLayout title="Projects" description="Every repository in the Kotoshu ecosystem — the core gem, LSP server, HTTP API, Python/JS/Go SDKs, GitHub Action, Docker image, and the content repos behind them.">
  <section class="relative overflow-hidden">
    <div class="zen-glow" aria-hidden="true"></div>
    <VerticalAccent text="生態系" />
    <div class="relative mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 pt-20 pb-16">
      <SectionHeading
        jp="生態系"
        eyebrow="Projects"
        title="One engine, thirteen repositories"
        lead="Core, surfaces, content, and site. Each surface is a thin adapter; each content repo is fetched on demand by the cache layer."
      />
    </div>
  </section>

  {groups.map((group) => (
    <section class="border-t border-[var(--color-border)]">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16">
        <p class="eyebrow mb-8 animate-in">
          <span class="jp" lang="ja">{group.jp}</span>{group.label}
        </p>
        <div class="grid gap-4 md:grid-cols-2">
          {group.ids.map((id) => {
            const p = PROJECTS.find((x) => x.id === id)!
            return (
              <article
                id={p.id}
                class="scroll-mt-24 rounded-xl border border-[var(--color-border)] p-6 transition-colors duration-300 hover:border-[var(--color-accent)] animate-in"
              >
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <h3 class="font-mono text-[15px] font-semibold text-[var(--color-text)]">{p.name}</h3>
                  <div class="flex items-center gap-2">
                    <span class={`rounded-full px-2.5 py-0.5 text-[10px] font-medium uppercase tracking-wider ${STATUS_STYLE[p.status]}`}>
                      {p.status}
                    </span>
                    <span class="text-[11px] text-[var(--color-text-3)]">{p.lang}</span>
                  </div>
                </div>
                <p class="mt-1.5 text-sm font-medium text-[var(--color-accent)]">{p.tagline}</p>
                <p class="mt-3 text-[13px] leading-6 text-[var(--color-text-2)]">{p.description}</p>
                {p.install && (
                  <pre class="code-block mt-4 overflow-x-auto px-3.5 py-2.5 text-xs"><code>{p.install}</code></pre>
                )}
                <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs">
                  <a href={p.repo} class="font-medium text-[var(--color-accent)] hover:underline" rel="noopener">
                    Repository ↗
                  </a>
                  {p.audiences.map((aud) => (
                    <a href={`/audiences#${aud}`} class="text-[var(--color-text-3)] hover:text-[var(--color-text-2)]">
                      {audienceName(aud)}
                    </a>
                  ))}
                </div>
              </article>
            )
          })}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>
